# MySQL connection string for Prisma (required)
# Example: mysql://USER:PASSWORD@localhost:3306/taskflow
PRISMA_DATABASE_CONNECTION_URL=

# JSON Web Token secret used to sign auth cookies (required)
JWT_SECRET=

# Port for the Nuxt dev server
APP_PORT=3000

# GitHub OAuth (required for GitHub SSO)
# 1. Create an OAuth App at https://github.com/settings/developers → OAuth Apps → New OAuth App
# 2. Homepage URL: http://localhost:3000
# 3. Authorization callback URL: http://localhost:3000/auth/github/callback
# 4. Copy Client ID and generate a Client Secret into the vars below
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/auth/github/callback

# Optional seams for local/API tests against mock-oauth2-server (see .codevalid/)
# GITHUB_OAUTH_AUTHORIZATION_URL=http://localhost:9101/github/authorize
# GITHUB_OAUTH_TOKEN_URL=http://localhost:9101/github/token
# GITHUB_OAUTH_USERINFO_URL=http://localhost:9101/github/userinfo
# GITHUB_API_BASE_URL=http://localhost:9101

# Workspace email gate (stands in for customer Toggl workspace check)
# When MOCK_WORKSPACE=true, emails are matched against mocks/workspace/users.json
MOCK_WORKSPACE=true

# Used when MOCK_WORKSPACE is not true — comma-separated allowlist
ALLOWED_WORKSPACE_EMAILS=admin@example.com,dev@example.com
