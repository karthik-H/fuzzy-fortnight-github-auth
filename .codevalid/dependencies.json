{
  "dependencies": [
    {
      "name": "mysql",
      "kind": "database",
      "provisioner": "testcontainers",
      "image": "mysql:8",
      "canonical_port": 3306,
      "toxiproxy_listen_port": 3306,
      "upstream": "mysql:3306",
      "runtime_value": "mysql://app:app@toxiproxy:3306/appdb",
      "env_var": "PRISMA_DATABASE_CONNECTION_URL"
    },
    {
      "name": "github_identity",
      "kind": "http_api",
      "provisioner": "mock-oauth2-server",
      "image": "ghcr.io/navikt/mock-oauth2-server:6.0.0",
      "canonical_port": 9101,
      "toxiproxy_listen_port": 9101,
      "upstream": "mock-oauth2-server:8080",
      "runtime_value": "http://toxiproxy:9101",
      "env_var": "GITHUB_OAUTH_AUTHORIZATION_URL",
      "issuer": "github"
    }
  ],
  "service_port": 6713,
  "health_check_path": "/api/health",
  "api_base_path": "/api",
  "api_probe_path": "/api/health"
}
